@{
    ViewData["Title"] = "Profile";
    var display = ViewData["DisplayName"] as string ?? "User";
}
<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <i class="bi bi-person-circle fs-1 me-3" aria-hidden="true"></i>
          <div>
            <h5 class="mb-0">@display</h5>
            <small class="text-body-secondary">Signed in</small>
          </div>
        </div>

        <div class="d-flex gap-2">
          <a href="/" class="btn btn-outline-secondary">Home</a>
          <form method="post" action="/Account/Logout" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Logout</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  
</div>

