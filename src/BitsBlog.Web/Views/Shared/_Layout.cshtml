@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var title = ViewData["Title"] as string ?? "BitsBlog";
    var apiBase = (Configuration["Api:BaseUrl"] ?? "/api/").TrimEnd('/');
}
<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title</title>
    <script>
      // Initialize theme: read from localStorage; default to system preference (then dark)
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          var theme;
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else {
            var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            theme = prefersDark ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-bs-theme', theme);

          // Ensure <meta name="theme-color"> reflects current theme
          var metaTheme = document.querySelector('meta[name="theme-color"]');
          if (!metaTheme) {
            metaTheme = document.createElement('meta');
            metaTheme.setAttribute('name','theme-color');
            document.head.appendChild(metaTheme);
          }
          metaTheme.setAttribute('content', theme === 'dark' ? '#212529' : '#ffffff');
        } catch (e) {
          document.documentElement.setAttribute('data-bs-theme', 'dark');
        }
      })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
      /* Subtle glassy navbar and smooth transitions */
      .navbar {
        -webkit-backdrop-filter: saturate(1.5) blur(8px);
        backdrop-filter: saturate(1.5) blur(8px);
        transition: background-color .3s ease, color .3s ease, border-color .3s ease;
      }

      /* CKEditor theming aligned with Bootstrap variables */
      html[data-bs-theme="dark"] .ck.ck-toolbar {
        background-color: #2b3035; /* ~ bg-dark-subtle */
        border-color: var(--bs-border-color);
        color: var(--bs-body-color);
      }
      html[data-bs-theme="dark"] .ck.ck-toolbar .ck-button,
      html[data-bs-theme="dark"] .ck.ck-toolbar .ck-dropdown,
      html[data-bs-theme="dark"] .ck.ck-toolbar .ck.ck-icon {
        color: var(--bs-body-color);
      }
      html[data-bs-theme="dark"] .ck.ck-button:hover,
      html[data-bs-theme="dark"] .ck.ck-button.ck-on {
        background-color: rgba(255,255,255,.08);
      }
      html[data-bs-theme="dark"] .ck.ck-editor__main > .ck-editor__editable {
        background-color: #1f2225;
        color: var(--bs-body-color);
        border-color: var(--bs-border-color);
      }
      html[data-bs-theme="dark"] .ck.ck-editor__editable.ck-focused {
        border-color: var(--bs-primary);
        box-shadow: 0 0 0 .25rem rgba(13,110,253,.25);
      }
      html[data-bs-theme="dark"] .ck-content a {
        color: var(--bs-link-color);
      }
      html[data-bs-theme="dark"] .ck-content pre,
      html[data-bs-theme="dark"] .ck-content code {
        background-color: #343a40;
        color: #e9ecef;
      }
      html[data-bs-theme="dark"] .ck-content blockquote {
        border-left: .25rem solid var(--bs-border-color);
        color: var(--bs-secondary-color);
      }
    </style>
  </head>
  <body>
    <nav id="mainNavbar" class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/">BitsBlog</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><a class="nav-link" href="/Posts">Posts</a></li>
            <li class="nav-item"><a class="nav-link" href="/Posts/Create">New Post</a></li>
          </ul>
          <div class="d-lg-flex align-items-center ms-lg-3 mt-2 mt-lg-0">
            <button id="themeToggle" type="button" class="btn btn-outline-light btn-sm" aria-label="Toggle theme" title="Toggle theme">
              <i id="themeToggleIcon" class="bi" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>
    </nav>

    <main class="container my-4">
      @RenderBody()
    </main>

    <script>
      window.API_BASE = '@apiBase/';
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      (function(){
        var btn = document.getElementById('themeToggle');
        var icon = document.getElementById('themeToggleIcon');
        function applyNavbarTheme(theme){
          var navbar = document.getElementById('mainNavbar');
          if (!navbar) return;
          // Always apply dark navbar regardless of theme
          navbar.classList.remove('navbar-dark','bg-dark','navbar-light','bg-body-tertiary','bg-body','bg-opacity-75','shadow-sm','border-bottom','bg-light');
          navbar.classList.add('navbar-dark','bg-dark','bg-opacity-75','shadow-sm');
          if (btn) { btn.classList.remove('btn-outline-dark'); btn.classList.add('btn-outline-light'); }
          // Sync meta theme-color with current theme
          var metaTheme = document.querySelector('meta[name="theme-color"]');
          if (metaTheme) {
            metaTheme.setAttribute('content', theme === 'dark' ? '#212529' : '#ffffff');
          }
        }
        function currentTheme(){
          return document.documentElement.getAttribute('data-bs-theme') || 'dark';
        }
        function setIcon(theme){
          if (!icon || !btn) return;
          icon.classList.remove('bi-sun','bi-moon');
          if (theme === 'dark') {
            icon.classList.add('bi-sun');
            btn.setAttribute('aria-label','Switch to light mode');
            btn.title = 'Switch to light mode';
          } else {
            icon.classList.add('bi-moon');
            btn.setAttribute('aria-label','Switch to dark mode');
            btn.title = 'Switch to dark mode';
          }
          applyNavbarTheme(theme);
        }
        function toggleTheme(){
          var next = currentTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-bs-theme', next);
          try { localStorage.setItem('theme', next); } catch(e) {}
          setIcon(next);
        }
        setIcon(currentTheme());
        if (btn) btn.addEventListener('click', toggleTheme);
        // Sync across tabs via storage events
        window.addEventListener('storage', function(e){
          if (e && e.key === 'theme') {
            var val = e.newValue;
            if (val === 'light' || val === 'dark') {
              document.documentElement.setAttribute('data-bs-theme', val);
              setIcon(val);
            }
          }
        });
      })();
    </script>
    @RenderSection("Scripts", required: false)
  </body>
  </html>



