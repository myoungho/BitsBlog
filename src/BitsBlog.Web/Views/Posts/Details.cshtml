@model BitsBlog.Web.Models.PostDetailsViewModel
@{
    ViewData["Title"] = "Post Details";
}

<div class="d-flex gap-2 mb-3">
  <a class="btn btn-outline-secondary" href="/Posts">Back to Posts</a>
  @if (Model.IsAdmin || (!string.IsNullOrWhiteSpace(Model.CurrentUserLoginId) && string.Equals(Model.CurrentUserLoginId, Model.Post.AuthorLoginId, System.StringComparison.OrdinalIgnoreCase)))
  {
    <a class="btn btn-primary" href="/Posts/Edit/@Model.Post.Id">Edit</a>
    <form asp-action="Delete" asp-route-id="@Model.Post.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete?');">
      @Html.AntiForgeryToken()
      <button type="submit" class="btn btn-danger">Delete</button>
    </form>
  }
</div>

<div class="card mb-4">
  <div class="card-body">
    <h1 class="h4 mb-1">@Model.Post.Title</h1>
    <div class="text-muted mb-3">
      @if (!string.IsNullOrWhiteSpace(Model.Post.AuthorDisplayName)) {
        <text>By @Model.Post.AuthorDisplayName</text>
      }
      <span class="ms-2">Created: @Model.Post.Created.ToLocalTime()</span>
    </div>
    <div class="mb-0">@Html.Raw(Model.Post.Content)</div>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <h2 class="h5 mb-3">Comments</h2>
    @if ((Model.Comments?.Count ?? 0) == 0)
    {
      <div class="text-muted">No comments yet.</div>
    }
    else
    {
      <ul class="list-group list-group-flush">
        @foreach (var c in Model.Comments)
        {
          <li class="list-group-item">
            <div class="small text-muted mb-1">
              @if (!string.IsNullOrWhiteSpace(c.AuthorDisplayName)) {
                <text>@c.AuthorDisplayName</text>
              } else {
                <text>Anonymous</text>
              }
              <span class="ms-2">@c.Created.ToLocalTime()</span>
            </div>
            <div id="c-view-@c.Id" class="mb-2">@Html.Raw(c.Content)</div>
            @if (Model.IsAdmin || (!string.IsNullOrWhiteSpace(Model.CurrentUserLoginId) && string.Equals(Model.CurrentUserLoginId, c.AuthorLoginId, System.StringComparison.OrdinalIgnoreCase)))
            {
              <div class="d-flex gap-2 align-items-start">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleEdit(@c.Id, true)">
                  <i class="bi bi-pencil"></i> Edit
                </button>
                <form asp-action="DeleteComment" method="post" class="d-inline" onsubmit="return confirm('Delete this comment?');">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="postId" value="@Model.Post.Id" />
                  <input type="hidden" name="commentId" value="@c.Id" />
                  <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete</button>
                </form>
              </div>
              <form id="c-edit-@c.Id" asp-action="EditComment" method="post" class="d-none mt-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@Model.Post.Id" />
                <input type="hidden" name="commentId" value="@c.Id" />
                <div class="mb-2">
                  <textarea name="content" class="form-control" rows="3">@c.Content</textarea>
                </div>
                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-save"></i> Save</button>
                  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleEdit(@c.Id, false)"><i class="bi bi-x-lg"></i> Cancel</button>
                </div>
              </form>
            }
          </li>
        }
      </ul>
    }
  </div>
</div>

@if (Context.Request.Cookies["jwt"] != null)
{
  <div class="card">
    <div class="card-body">
      <h3 class="h6 mb-2">Add a comment</h3>
      <form asp-action="AddComment" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="postId" value="@Model.Post.Id" />
        <div class="mb-2">
          <textarea name="content" class="form-control" rows="3" placeholder="Write a comment..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
      </form>
    </div>
  </div>
}

<script>
  function toggleEdit(id, show) {
    var edit = document.getElementById('c-edit-' + id);
    var view = document.getElementById('c-view-' + id);
    if (!edit || !view) return;
    if (show) {
      edit.classList.remove('d-none');
      view.classList.add('d-none');
      var ta = edit.querySelector('textarea[name="content"]');
      if (ta) { try { ta.focus(); ta.select(); } catch(e){} }
    } else {
      edit.classList.add('d-none');
      view.classList.remove('d-none');
    }
  }
</script>
