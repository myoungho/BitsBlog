@model BitsBlog.Application.DTOs.PostDto
@{
    ViewData["Title"] = "Post Details";
}

<div class="d-flex gap-2 mb-3">
  <a class="btn btn-outline-secondary" href="/Posts">Back to Posts</a>
  <a class="btn btn-primary" href="/Posts/Edit/@Model.Id">Edit</a>
  <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm(\'Are you sure you want to delete?\');">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
  </form>
</div>

<div class="card">
  <div class="card-body">
    <h1 class="h4">@Model.Title</h1>
    <div class="text-muted mb-3">Created: @Model.Created.ToLocalTime()</div>
    <div class="mb-0">@Html.Raw(Model.Content)</div>
  </div>
</div>


