@model BitsBlog.Web.Models.PagedResult<BitsBlog.Application.DTOs.PostDto>
@{
    ViewData["Title"] = "Posts";
    var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
    var q = ViewData["q"] as string;
    var sort = ViewData["sort"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Posts</h1>
    <a class="btn btn-primary" href="/Posts/Create">New Post</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
  <div class="col-md-6">
    <label class="form-label" for="q">검색</label>
    <input class="form-control" type="text" id="q" name="q" value="@q" placeholder="제목/내용" />
  </div>
  <div class="col-md-3">
    <label class="form-label" for="sort">정렬</label>
    <select class="form-select" id="sort" name="sort">
      @if (string.IsNullOrEmpty(sort))
      {
        <option value="" selected="selected">최신순</option>
      }
      else
      {
        <option value="">최신순</option>
      }
      @if (string.Equals(sort, "created_asc"))
      {
        <option value="created_asc" selected="selected">오래된순</option>
      }
      else
      {
        <option value="created_asc">오래된순</option>
      }
    </select>
  </div>
  <div class="col-md-3">
    <label class="form-label d-block">&nbsp;</label>
    <button type="submit" class="btn btn-outline-primary">검색</button>
  </div>
</form>

@if (Model.Items is null || !Model.Items.Any())
{
    <div class="alert alert-info">No posts yet.</div>
}
else
{
    <ul class="list-group">
    @foreach (var post in Model.Items)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <a class="fw-semibold" asp-action="Details" asp-route-id="@post.Id">@post.Title</a>
              @if (!string.IsNullOrWhiteSpace(post.AuthorDisplayName))
              {
                <small class="text-muted ms-2">by @post.AuthorDisplayName</small>
              }
            </div>
            <small class="text-muted">@post.Created.ToLocalTime()</small>
        </li>
    }
    </ul>
    @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", new BitsBlog.Web.Models.PaginationModel { Action = "Index", Controller = "Posts", Page = Model.Page, PageSize = Model.PageSize, Total = Model.Total, ExtraRouteValues = new System.Collections.Generic.Dictionary<string, object?> { ["q"] = q, ["sort"] = sort } })
}
