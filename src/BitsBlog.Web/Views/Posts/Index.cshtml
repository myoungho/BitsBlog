@model BitsBlog.Web.Controllers.PostsController.Paged<BitsBlog.Application.DTOs.PostDto>
@{
    ViewData["Title"] = "Posts";
    var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Posts</h1>
    <a class="btn btn-primary" href="/Posts/Create">New Post</a>
</div>

@if (Model.Items is null || !Model.Items.Any())
{
    <div class="alert alert-info">No posts yet.</div>
}
else
{
    <ul class="list-group">
    @foreach (var post in Model.Items)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <a class="fw-semibold" asp-action="Details" asp-route-id="@post.Id">@post.Title</a>
              @if (!string.IsNullOrWhiteSpace(post.AuthorDisplayName))
              {
                <small class="text-muted ms-2">by @post.AuthorDisplayName</small>
              }
            </div>
            <small class="text-muted">@post.Created.ToLocalTime()</small>
        </li>
    }
    </ul>
    @if (totalPages > 1)
    {
      <nav class="mt-3" aria-label="Posts pagination">
        <ul class="pagination">
          <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
            <a class="page-link" href="@Url.Action("Index", new { page = Model.Page - 1, pageSize = Model.PageSize })" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a>
          </li>
          @for (var p = 1; p <= totalPages; p++)
          {
            <li class="page-item @(p == Model.Page ? "active" : string.Empty)"><a class="page-link" href="@Url.Action("Index", new { page = p, pageSize = Model.PageSize })">@p</a></li>
          }
          <li class="page-item @(Model.Page >= totalPages ? "disabled" : string.Empty)">
            <a class="page-link" href="@Url.Action("Index", new { page = Model.Page + 1, pageSize = Model.PageSize })" aria-label="Next"><span aria-hidden="true">&raquo;</span></a>
          </li>
        </ul>
      </nav>
    }
}

