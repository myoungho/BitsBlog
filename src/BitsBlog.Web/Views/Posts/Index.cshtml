@model IEnumerable<BitsBlog.Application.DTOs.PostDto>
@{
    ViewData["Title"] = "Posts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Posts</h1>
    <a class="btn btn-primary" href="/Posts/Create">New Post</a>
    </div>

@if (Model is null || !Model.Any())
{
    <div class="alert alert-info">No posts yet.</div>
}
else
{
    <ul class="list-group">
    @foreach (var post in Model)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <a class="fw-semibold" asp-action="Details" asp-route-id="@post.Id">@post.Title</a>
              @if (!string.IsNullOrWhiteSpace(post.AuthorDisplayName))
              {
                <small class="text-muted ms-2">by @post.AuthorDisplayName</small>
              }
            </div>
            <small class="text-muted">@post.Created.ToLocalTime()</small>
        </li>
    }
    </ul>
}



