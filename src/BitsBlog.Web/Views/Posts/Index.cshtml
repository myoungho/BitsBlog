@model BitsBlog.Application.DTO.Common.PagedResult<PostDto>
@{
    ViewData["Title"] = "Posts";
    var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Posts</h1>
    <a class="btn btn-primary" href="/Posts/Create">New Post</a>
</div>

@if (ViewData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
  <div class="alert alert-danger">@err</div>
}



@if (Model.Items is null || !Model.Items.Any())
{
    <div class="alert alert-info">No posts yet.</div>
}
else
{
    <ul class="list-group">
    @foreach (var post in Model.Items)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <a class="fw-semibold" asp-action="Details" asp-route-id="@post.Id">@post.Title</a>
              @if (!string.IsNullOrWhiteSpace(post.AuthorDisplayName))
              {
                <small class="text-muted ms-2">by @post.AuthorDisplayName</small>
              }
            </div>
            <small class="text-muted">@post.Created.ToLocalTime()</small>
        </li>
    }
    </ul>
    @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", new BitsBlog.Web.Models.PaginationModel { Action = "Index", Controller = "Posts", Page = Model.Page, PageSize = Model.PageSize, Total = Model.Total })
}



