@{
    string active(string ctl)
        => string.Equals((string?)ViewContext.RouteData.Values["controller"], ctl, System.StringComparison.OrdinalIgnoreCase)
           ? "active" : string.Empty;
}
<div class="content-narrow">
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 pb-2 mb-3 border-bottom">
    <h1 class="h4 mb-0">Admin</h1>
    <nav aria-label="Admin navigation">
      <ul class="nav nav-pills gap-1">
        <li class="nav-item"><a class="nav-link @active("Home")" href="/Admin"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
        <li class="nav-item"><a class="nav-link @active("Users")" href="/Admin/Users"><i class="bi bi-people me-1"></i>Users</a></li>
        <li class="nav-item"><a class="nav-link @active("Posts")" href="/Admin/Posts"><i class="bi bi-journal-text me-1"></i>Posts</a></li>
        <li class="nav-item"><a class="nav-link @active("Comments")" href="/Admin/Comments"><i class="bi bi-chat-left-text me-1"></i>Comments</a></li>
      </ul>
    </nav>
  </div>
</div>


