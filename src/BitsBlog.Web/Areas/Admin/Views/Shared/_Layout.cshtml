@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var title = (ViewData["Title"] as string ?? "Admin") + " • BitsBlog";
    var apiBase = (Configuration["Api:BaseUrl"] ?? "/api/").TrimEnd('/');
    string? userDisplay = null;
    string? userRole = null;
    var jwt = Context.Request.Cookies["jwt"];
    if (!string.IsNullOrEmpty(jwt))
    {
        userDisplay = BitsBlog.Web.Services.JwtReader.TryGetDisplayName(jwt);
        userRole = BitsBlog.Web.Services.JwtReader.TryGetRole(jwt);
    }
}
<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title</title>
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('theme');
                var theme;
                if (stored === 'light' || stored === 'dark') {
                    theme = stored;
                } else {
                    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                    theme = prefersDark ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', theme);
                var metaTheme = document.querySelector('meta[name="theme-color"]');
                if (!metaTheme) { metaTheme = document.createElement('meta'); metaTheme.setAttribute('name', 'theme-color'); document.head.appendChild(metaTheme); }
                metaTheme.setAttribute('content', theme === 'dark' ? '#212529' : '#ffffff');
            } catch (e) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        .content-narrow { max-width: 960px; margin-inline: auto; width: 100%; }
    </style>
    @RenderSection("Head", required: false)
  </head>
  <body>
    <nav id="adminNavbar" class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/Admin">BitsBlog Admin</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            @{ var curPath = Context?.Request?.Path.Value ?? string.Empty; }
            <li class="nav-item"><a class="nav-link @(curPath.Equals("/Admin", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/Admin"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
            <li class="nav-item"><a class="nav-link @(curPath.StartsWith("/Admin/Users", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/Admin/Users"><i class="bi bi-people me-1"></i>Users</a></li>
            <li class="nav-item"><a class="nav-link @(curPath.StartsWith("/Admin/Posts", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/Admin/Posts"><i class="bi bi-journal-text me-1"></i>Posts</a></li>
            <li class="nav-item"><a class="nav-link @(curPath.StartsWith("/Admin/Comments", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/Admin/Comments"><i class="bi bi-chat-left-text me-1"></i>Comments</a></li>
            <li class="nav-item"><a class="nav-link" href="/"><i class="bi bi-house me-1"></i>Site</a></li>
          </ul>
          <div class="d-lg-flex align-items-center ms-lg-3 mt-2 mt-lg-0 gap-2">
            @if (Context?.Request?.Cookies["jwt"] == null)
            {
                <a class="btn btn-outline-light btn-sm" href="/Account/Login">Login</a>
            }
            else
            {
                <div class="dropdown d-inline-block">
                    <button class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center" type="button" id="adminProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Profile menu">
                        <i class="bi bi-person-circle me-1" aria-hidden="true"></i>
                        @(userDisplay ?? "User")
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminProfileDropdown">
                        <li>
                            <a class="dropdown-item" href="/Account/Profile">
                                <i class="bi bi-person me-2" aria-hidden="true"></i>Profile
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form method="post" action="/Account/Logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            <button id="adminThemeToggle" type="button" class="btn btn-outline-light btn-sm" aria-label="Toggle theme" title="Toggle theme">
                <i id="adminThemeToggleIcon" class="bi" aria-hidden="true"></i>
            </button>
          </div>
        
        </div>
      </div>
    </nav>

    <main class="container my-4">
      <div class="content-narrow">
        @RenderBody()
      </div>
    </main>

    <script>window.API_BASE='@apiBase/';</script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      (function(){
        var btn = document.getElementById('adminThemeToggle');
        var icon = document.getElementById('adminThemeToggleIcon');
        function currentTheme(){
          return document.documentElement.getAttribute('data-bs-theme') || 'dark';
        }
        function setIcon(theme){
          if (!icon || !btn) return;
          icon.classList.remove('bi-sun','bi-moon');
          if (theme === 'dark') {
            icon.classList.add('bi-sun');
            btn.setAttribute('aria-label','Switch to light mode');
            btn.title = 'Switch to light mode';
          } else {
            icon.classList.add('bi-moon');
            btn.setAttribute('aria-label','Switch to dark mode');
            btn.title = 'Switch to dark mode';
          }
        }
        function toggleTheme(){
          var next = currentTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-bs-theme', next);
          try { localStorage.setItem('theme', next); } catch(e) {}
          setIcon(next);
          var metaTheme = document.querySelector('meta[name="theme-color"]');
          if (metaTheme) metaTheme.setAttribute('content', next === 'dark' ? '#212529' : '#ffffff');
        }
        setIcon(currentTheme());
        if (btn) btn.addEventListener('click', toggleTheme);
        window.addEventListener('storage', function(e){
          if (e && e.key === 'theme') {
            var val = e.newValue;
            if (val === 'light' || val === 'dark') {
              document.documentElement.setAttribute('data-bs-theme', val);
              setIcon(val);
            }
          }
        });
      })();
    </script>
    @RenderSection("Scripts", required: false)
  </body>
</html>
