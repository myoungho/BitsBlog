@model BitsBlog.Application.DTO.Common.PagedResult<BitsBlog.Web.Areas.Admin.Controllers.CommentsController.CommentVm>
@{
    ViewData["Title"] = "Comments";
    var postId = ViewData["PostId"] as int?;
    var q = ViewData["q"] as string; var sort = ViewData["sort"] as string;
}


@if (ViewData["Error"] is string err && !string.IsNullOrWhiteSpace(err)) {<div class="alert alert-danger">@err</div>}
@if (TempData["Error"] is string tempErr) {<div class="alert alert-danger">@tempErr</div>}
@{
  var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
}

<div class="card shadow-sm mb-3">
  <div class="card-body">
    <form method="get" class="row g-2 align-items-center">
      <div class="col-auto">
        <label for="postId" class="col-form-label">Post ID</label>
      </div>
      <div class="col-auto">
        <input class="form-control" type="number" id="postId" name="postId" value="@postId" min="1" />
      </div>
      
      <div class="col-auto ms-auto text-body-secondary">Total @Model.Total</div>
    </form>
  </div>
  </div>

<div class="card shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
                <thead>
          <tr>
            <th>ID</th>
            <th>PostId</th>
            <th>Author</th>
            <th>Content</th>
            <th>Created</th>
            <th style="width:120px">Action</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Items) {
          <tr>
            <td>@c.Id</td>
            <td>@c.PostId</td>
            <td>@c.AuthorDisplayName</td>
            <td>
              <div class="text-truncate" style="max-width:420px">@Html.Raw(c.Content)</div>
            </td>
            <td>@c.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>
              <form method="post" asp-action="Delete" onsubmit="return confirm('Are you sure you want to delete this comment?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@c.PostId" />
                <input type="hidden" name="commentId" value="@c.Id" />
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
              </form>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    @if ((ViewData["PostId"] as int?).HasValue)
    {
      @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", new BitsBlog.Web.Models.PaginationModel { Area = "Admin", Controller = "Comments", Action = "Index", Page = Model.Page, PageSize = Model.PageSize, Total = Model.Total, ExtraRouteValues = new System.Collections.Generic.Dictionary<string, object?> { ["postId"] = ViewData["PostId"] } })
    }
  </div>
  </div>





