@model BitsBlog.Web.Areas.Admin.Controllers.CommentsController.Paged<BitsBlog.Web.Areas.Admin.Controllers.CommentsController.CommentVm>
@{
    ViewData["Title"] = "코멘트관리";
    var postId = ViewData["PostId"] as int?;
}
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminNav.cshtml")
@if (TempData["Error"] is string err) {<div class="alert alert-danger">@err</div>}
@{
  var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
}

<div class="card shadow-sm mb-3">
  <div class="card-body">
    <form method="get" class="row g-2 align-items-center">
      <div class="col-auto">
        <label for="postId" class="col-form-label">Post ID</label>
      </div>
      <div class="col-auto">
        <input class="form-control" type="number" id="postId" name="postId" value="@postId" min="1" />
      </div>
      <div class="col-auto">
        <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>조회</button>
      </div>
      <div class="col-auto">
        <a class="btn btn-outline-secondary" href="/Admin/Comments">초기화</a>
      </div>
      <div class="col-auto ms-auto text-body-secondary">@Model.Total 개</div>
    </form>
  </div>
  </div>

<div class="card shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>PostId</th>
            <th>작성자</th>
            <th>내용</th>
            <th>작성일</th>
            <th style="width:120px">Action</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Items) {
          <tr>
            <td>@c.Id</td>
            <td>@c.PostId</td>
            <td>@c.AuthorDisplayName</td>
            <td>
              <div class="text-truncate" style="max-width:420px">@Html.Raw(c.Content)</div>
            </td>
            <td>@c.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>
              <form method="post" asp-action="Delete" onsubmit="return confirm('삭제하시겠습니까?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@c.PostId" />
                <input type="hidden" name="commentId" value="@c.Id" />
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>삭제</button>
              </form>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    @if ((ViewData["PostId"] as int?).HasValue && totalPages > 1)
    {
      <nav class="mt-3" aria-label="Comments pagination">
        <ul class="pagination">
          <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
            <a class="page-link" href="@Url.Action("Index", new { postId = ViewData["PostId"], page = Model.Page - 1, pageSize = Model.PageSize })" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a>
          </li>
          @for (var p = 1; p <= totalPages; p++)
          {
            <li class="page-item @(p == Model.Page ? "active" : string.Empty)"><a class="page-link" href="@Url.Action("Index", new { postId = ViewData["PostId"], page = p, pageSize = Model.PageSize })">@p</a></li>
          }
          <li class="page-item @(Model.Page >= totalPages ? "disabled" : string.Empty)">
            <a class="page-link" href="@Url.Action("Index", new { postId = ViewData["PostId"], page = Model.Page + 1, pageSize = Model.PageSize })" aria-label="Next"><span aria-hidden="true">&raquo;</span></a>
          </li>
        </ul>
      </nav>
    }
  </div>
</div>
