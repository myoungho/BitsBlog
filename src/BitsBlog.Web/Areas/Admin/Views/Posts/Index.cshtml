@model BitsBlog.Application.DTO.Common.PagedResult<BitsBlog.Web.Areas.Admin.Controllers.PostsController.PostVm>
@{
    ViewData["Title"] = "Posts";
}

@if (ViewData["Error"] is string err && !string.IsNullOrWhiteSpace(err)) {<div class="alert alert-danger">@err</div>}
@{
  var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
}
@if (TempData["Error"] is string tempErr) {<div class="alert alert-danger">@tempErr</div>}

<div class="card shadow-sm">
  <div class="card-body">
    
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h5 class="card-title mb-0">Posts</h5>
      <span class="text-body-secondary">Total @Model.Total items</span>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
                <thead>
          <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>Created</th>
            <th style="width:140px">Action</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Items) {
          <tr>
            <td>@p.Id</td>
            <td class="text-truncate" style="max-width: 380px">@p.Title</td>
            <td>@p.AuthorDisplayName</td>
            <td>@p.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>
              <form method="post" asp-action="Delete" onsubmit="return confirm('ì‚­ì œí•˜ì‹œê² ìŠµë‹ˆê¹Œ?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@p.Id" />
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
              </form>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", new BitsBlog.Web.Models.PaginationModel { Area = "Admin", Controller = "Posts", Action = "Index", Page = Model.Page, PageSize = Model.PageSize, Total = Model.Total })
  </div>
</div>




