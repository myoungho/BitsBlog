@model BitsBlog.Web.Models.PagedResult<BitsBlog.Web.Areas.Admin.Controllers.PostsController.PostVm>
@{
    ViewData["Title"] = "게시글관리";
}
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminNav.cshtml")
@{
  var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
  var q = ViewData["q"] as string;
  var sort = ViewData["sort"] as string;
}
@if (TempData["Error"] is string err) {<div class="alert alert-danger">@err</div>}

<div class="card shadow-sm">
  <div class="card-body">
    <form method="get" class="row g-2 align-items-end mb-3">
      <div class="col-md-6">
        <label class="form-label" for="q">검색</label>
        <input class="form-control" type="text" id="q" name="q" value="@q" placeholder="제목/내용" />
      </div>
      <div class="col-md-3">
        <label class="form-label" for="sort">정렬</label>
        <select class="form-select" id="sort" name="sort">
          @if (string.IsNullOrEmpty(sort)) {<option value="" selected="selected">최신순</option>} else {<option value="">최신순</option>}
          @if (string.Equals(sort,"created_asc")) {<option value="created_asc" selected="selected">오래된순</option>} else {<option value="created_asc">오래된순</option>}
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label d-block">&nbsp;</label>
        <button type="submit" class="btn btn-outline-primary">검색</button>
      </div>
    </form>
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h5 class="card-title mb-0">게시글관리</h5>
      <span class="text-body-secondary">총 @Model.Total 건</span>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>제목</th>
            <th>작성자</th>
            <th>작성일</th>
            <th style="width:140px">Action</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Items) {
          <tr>
            <td>@p.Id</td>
            <td class="text-truncate" style="max-width: 380px">@p.Title</td>
            <td>@p.AuthorDisplayName</td>
            <td>@p.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>
              <form method="post" asp-action="Delete" onsubmit="return confirm('삭제하시겠습니까?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@p.Id" />
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>삭제</button>
              </form>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", new BitsBlog.Web.Models.PaginationModel { Area = "Admin", Controller = "Posts", Action = "Index", Page = Model.Page, PageSize = Model.PageSize, Total = Model.Total, ExtraRouteValues = new System.Collections.Generic.Dictionary<string, object?> { ["q"] = q, ["sort"] = sort } })
  </div>
</div>
