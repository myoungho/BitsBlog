@model BitsBlog.Web.Models.PagedResult<BitsBlog.Web.Areas.Admin.Controllers.PostsController.PostVm>
@{
    ViewData["Title"] = "Posts";
}
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminNav.cshtml")
@{
  var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
  var q = ViewData["q"] as string;
  var sort = ViewData["sort"] as string;
}
@if (TempData["Error"] is string err) {<div class="alert alert-danger">@err</div>}

<div class="card shadow-sm">
  <div class="card-body">
        <form method="get" class="row g-2 align-items-end mb-3">
      <div class="col-md-6">
        <label class="form-label" for="q">Search</label>
        <input class="form-control" type="text" id="q" name="q" value="@q" placeholder="Title/Content" />
      </div>
      <div class="col-md-3">
        <label class="form-label" for="sort">Sort</label>
        <select class="form-select" id="sort" name="sort">
          @if (string.IsNullOrEmpty(sort)) {<option value="" selected="selected">Default</option>} else {<option value="">Default</option>}
          @if (string.Equals(sort,"created_asc")) {<option value="created_asc" selected="selected">Oldest first</option>} else {<option value="created_asc">Oldest first</option>}
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label d-block">&nbsp;</label>
        <button type="submit" class="btn btn-outline-primary">Search</button>
      </div>
    </form>
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h5 class="card-title mb-0">Posts</h5>
      <span class="text-body-secondary">Total @Model.Total items</span>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
                <thead>
          <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>Created</th>
            <th style="width:140px">Action</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Items) {
          <tr>
            <td>@p.Id</td>
            <td class="text-truncate" style="max-width: 380px">@p.Title</td>
            <td>@p.AuthorDisplayName</td>
            <td>@p.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>
              <form method="post" asp-action="Delete" onsubmit="return confirm('ì‚­ì œí•˜ì‹œê² ìŠµë‹ˆê¹Œ?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@p.Id" />
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
              </form>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", new BitsBlog.Web.Models.PaginationModel { Area = "Admin", Controller = "Posts", Action = "Index", Page = Model.Page, PageSize = Model.PageSize, Total = Model.Total, ExtraRouteValues = new System.Collections.Generic.Dictionary<string, object?> { ["q"] = q, ["sort"] = sort } })
  </div>
</div>


