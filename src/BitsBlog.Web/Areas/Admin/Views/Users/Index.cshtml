@model BitsBlog.Web.Models.PagedResult<BitsBlog.Web.Areas.Admin.Controllers.UsersController.UserVm>
@{
    ViewData["Title"] = "Users";
}
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminNav.cshtml")
@{
  var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
  var q = ViewData["q"] as string;
  var sort = ViewData["sort"] as string;
}

@if (TempData["Error"] is string err) {<div class="alert alert-danger">@err</div>}

<div class="card shadow-sm">
  <div class="card-body">
    <form method="get" class="row g-2 align-items-end mb-3">
      <div class="col-md-6">
        <label class="form-label" for="q">Search</label>
        <input class="form-control" type="text" id="q" name="q" value="@q" placeholder="LoginId/DisplayName" />
      </div>
      <div class="col-md-3">
        <label class="form-label" for="sort">Sort</label>
        <select class="form-select" id="sort" name="sort">
          @if (string.IsNullOrEmpty(sort)) {<option value="" selected="selected">Default</option>} else {<option value="">Default</option>}
          @if (string.Equals(sort,"created_asc")) {<option value="created_asc" selected="selected">Created (oldest first)</option>} else {<option value="created_asc">Created (oldest first)</option>}
          @if (string.Equals(sort,"login_asc")) {<option value="login_asc" selected="selected">LoginId (A-Z)</option>} else {<option value="login_asc">LoginId (A-Z)</option>}
          @if (string.Equals(sort,"login_desc")) {<option value="login_desc" selected="selected">LoginId (Z-A)</option>} else {<option value="login_desc">LoginId (Z-A)</option>}
          @if (string.Equals(sort,"name_asc")) {<option value="name_asc" selected="selected">Name (A-Z)</option>} else {<option value="name_asc">Name (A-Z)</option>}
          @if (string.Equals(sort,"name_desc")) {<option value="name_desc" selected="selected">Name (Z-A)</option>} else {<option value="name_desc">Name (Z-A)</option>}
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label d-block">&nbsp;</label>
        <button type="submit" class="btn btn-outline-primary">Search</button>
      </div>
    </form>
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h5 class="card-title mb-0">Users</h5>
      <span class="text-body-secondary">Total @Model.Total users</span>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>LoginId</th>
            <th>DisplayName</th>
            <th>Role</th>
            <th>Created</th>
            <th style="width:260px">Action</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Items) {
          <tr>
            <td>@u.Id</td>
            <td class="text-break">@u.LoginId</td>
            <td>@u.DisplayName</td>
            <td>
              @if (string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase)) {
                <span class="badge text-bg-danger">Admin</span>
              } else {
                <span class="badge text-bg-secondary">User</span>
              }
            </td>
            <td>@u.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>
              <div class="d-flex flex-wrap gap-1">
                @if (!string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase)) {
                  <form method="post" asp-action="Promote">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@u.Id" />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-shield-check me-1"></i>Promote</button>
                  </form>
                } else {
                  <form method="post" asp-action="Demote">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@u.Id" />
                    <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-shield-slash me-1"></i>Demote</button>
                  </form>
                }
                <form method="post" asp-action="Delete" onsubmit="return confirm('ì‚­ì œí•˜ì‹œê² ìŠµë‹ˆê¹Œ?')">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@u.Id" />
                  <select name="mode" class="form-select form-select-sm w-auto" title="Delete mode">
                    <option value="anonymize" selected>Anonymize</option>
                    <option value="cascade">Cascade delete</option>
                  </select>
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
                </form>
              </div>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", new BitsBlog.Web.Models.PaginationModel { Area = "Admin", Controller = "Users", Action = "Index", Page = Model.Page, PageSize = Model.PageSize, Total = Model.Total, ExtraRouteValues = new System.Collections.Generic.Dictionary<string, object?> { ["q"] = q, ["sort"] = sort } })
  </div>
</div>


