@model BitsBlog.Web.Areas.Admin.Controllers.UsersController.Paged<BitsBlog.Web.Areas.Admin.Controllers.UsersController.UserVm>
@{
    ViewData["Title"] = "회원관리";
}
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminNav.cshtml")
@{
  var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
}

@if (TempData["Error"] is string err) {<div class="alert alert-danger">@err</div>}

<div class="card shadow-sm">
  <div class="card-body">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h5 class="card-title mb-0">회원관리</h5>
      <span class="text-body-secondary">총 @Model.Total 명</span>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>LoginId</th>
            <th>DisplayName</th>
            <th>Role</th>
            <th>Created</th>
            <th style="width:260px">Action</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Items) {
          <tr>
            <td>@u.Id</td>
            <td class="text-break">@u.LoginId</td>
            <td>@u.DisplayName</td>
            <td>
              @if (string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase)) {
                <span class="badge text-bg-danger">Admin</span>
              } else {
                <span class="badge text-bg-secondary">User</span>
              }
            </td>
            <td>@u.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>
              <div class="d-flex flex-wrap gap-1">
                @if (!string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase)) {
                  <form method="post" asp-action="Promote">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@u.Id" />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-shield-check me-1"></i>승격</button>
                  </form>
                } else {
                  <form method="post" asp-action="Demote">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@u.Id" />
                    <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-shield-slash me-1"></i>강등</button>
                  </form>
                }
                <form method="post" asp-action="Delete" onsubmit="return confirm('삭제하시겠습니까?')">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@u.Id" />
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>삭제</button>
                </form>
              </div>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    @if (totalPages > 1)
    {
      <nav class="mt-3" aria-label="Users pagination">
        <ul class="pagination">
          <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
            <a class="page-link" href="@Url.Action("Index", new { page = Model.Page - 1, pageSize = Model.PageSize })" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a>
          </li>
          @for (var p = 1; p <= totalPages; p++)
          {
            <li class="page-item @(p == Model.Page ? "active" : string.Empty)"><a class="page-link" href="@Url.Action("Index", new { page = p, pageSize = Model.PageSize })">@p</a></li>
          }
          <li class="page-item @(Model.Page >= totalPages ? "disabled" : string.Empty)">
            <a class="page-link" href="@Url.Action("Index", new { page = Model.Page + 1, pageSize = Model.PageSize })" aria-label="Next"><span aria-hidden="true">&raquo;</span></a>
          </li>
        </ul>
      </nav>
    }
  </div>
</div>
