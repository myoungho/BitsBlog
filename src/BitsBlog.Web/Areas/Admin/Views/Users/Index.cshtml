@model BitsBlog.Application.DTO.Common.PagedResult<BitsBlog.Web.Areas.Admin.Controllers.UsersController.UserVm>
@{
    ViewData["Title"] = "Users";
}


@if (ViewData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger">@err</div>
}
@{
    var totalPages = (int)Math.Ceiling((double)Model.Total / Math.Max(1, Model.PageSize));
}

@if (TempData["Error"] is string tempErr)
{
    <div class="alert alert-danger">@tempErr</div>
}

<div class="card shadow-sm">
    <div class="card-body">

        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <h5 class="card-title mb-0">Users</h5>
            <div class="d-flex align-items-center gap-2 ms-auto">
                <span class="text-body-secondary">Total @Model.Total users</span>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
                    <i class="bi bi-person-plus me-1"></i>Add User
                </button>
            </div>
        </div>

        <div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserLabel" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="createUserLabel">Add User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                  <div class="mb-3">
                    <label for="newUserEmail" class="form-label">Email (loginId)</label>
                    <input type="email" class="form-control" id="newUserEmail" name="email" placeholder="name@example.com" required />
                  </div>
                  <div class="mb-3">
                    <label for="newUserDisplayName" class="form-label">Display name</label>
                    <input type="text" class="form-control" id="newUserDisplayName" name="displayName" placeholder="Optional" />
                  </div>
                  <div class="mb-3">
                    <label for="newUserPassword" class="form-label">Password</label>
                    <input type="password" class="form-control" id="newUserPassword" name="password" placeholder="Password" required />
                  </div>
                  <div class="mb-2">
                    <label for="newUserRole" class="form-label">Role</label>
                    <select id="newUserRole" name="role" class="form-select">
                      <option value="User" selected>User</option>
                      <option value="Admin">Admin</option>
                    </select>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-primary">Create</button>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>LoginId</th>
                        <th>DisplayName</th>
                        <th>Role</th>
                        <th>Created</th>
                        <th style="width:260px">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Items)
                    {
                        <tr>
                            <td>@u.Id</td>
                            <td class="text-break">@u.LoginId</td>
                            <td>@u.DisplayName</td>
                            <td>
                                @if (string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge text-bg-danger">Admin</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">User</span>
                                }
                            </td>
                            <td>@u.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @if (!string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form method="post" asp-action="Promote">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button class="btn btn-sm btn-outline-primary"><i class="bi bi-shield-check me-1"></i>Promote</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="Demote">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-shield-slash me-1"></i>Demote</button>
                                        </form>
                                    }
                                    <form method="post" asp-action="Delete" onsubmit="return confirm('Are you sure you want to delete this user? Their posts and comments will be anonymized.')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />

                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("~/Views/Shared/_Pagination.cshtml", new BitsBlog.Web.Models.PaginationModel { Area = "Admin", Controller = "Users", Action = "Index", Page = Model.Page, PageSize = Model.PageSize, Total = Model.Total })
    </div>
</div>

